# Required for the global leaderboard / ghost API in production.
# Either Vercel KV's variables or Upstash's directly will work — getKv() reads both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: point the dev client at a deployed API (e.g. a Vercel preview URL).
# Without this, dev uses localStorage.
# VITE_LEADERBOARD_API=https://flappin-ufo.vercel.app/api
